#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c '
. /lib/functions/leds.sh

# 检测机型
MODEL=$(cat /proc/device-tree/model 2>/dev/null | tr -d "\0")

# ============================================================
# wh5000机型
# ============================================================
if echo "$MODEL" | grep -q "WH5000"; then

    RED_LED="red:status"
    GREEN_LED="green:status"
    BLUE_LED="blue:status"

    # 开机完成：蓝灯灭，绿灯亮
    led_off "$RED_LED" 2>/dev/null
    led_off "$GREEN_LED" 2>/dev/null
    led_off "$BLUE_LED" 2>/dev/null 
    led_on "$GREEN_LED" 2>/dev/null

    while true; do
        if ping -c 1 -W 3 119.29.29.29 >/dev/null 2>&1; then
            # 已联网：绿灯 + 红灯同亮
            led_on "$GREEN_LED" 2>/dev/null
            led_on "$RED_LED" 2>/dev/null
        else
            # 未联网：仅绿灯亮
            led_on "$GREEN_LED" 2>/dev/null
            led_off "$RED_LED" 2>/dev/null
        fi
        sleep 10
    done

fi
'
    procd_set_param respawn
    procd_close_instance
}
